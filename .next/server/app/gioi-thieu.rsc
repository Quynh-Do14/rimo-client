:"City","name":"Hà Nội"},"sameAs":["https://www.facebook.com/rimo.vietnam"]},{"@context":"https://schema.org","@type":"Product","@id":"https://rimo.vn/#product","name":"Phim cách nhiệt Rimo","description":"Phim cách nhiệt ô tô Rimo cao cấp với công nghệ Nano Ceramic, chống tia UV 99%, cách nhiệt hiệu quả, bảo vệ sơn xe toàn diện","brand":{"@type":"Brand","name":"Rimo"},"category":"Phụ kiện ô tô","offers":{"@type":"AggregateOffer","priceCurrency":"VND","lowPrice":"1500000","highPrice":"10000000","offerCount":"5"}}]0:["SfsSBablkx7jNyvRORYG9",[[["",{"children":["gioi-thieu",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["gioi-thieu",{"children":["__PAGE__",{},[["$L1",["$","div",null,{"className":"main-layout-client","children":[["$","$L2",null,{}],[["$","div",null,{"className":"banner_bannerContainer__4y_Sw","children":["$","$L3",null,{"src":{"src":"/_next/static/media/Banner-Menu-GIoi-thieu.36b091e2.jpg","height":600,"width":1920,"blurDataURL":"data:image/jpeg;base64,","blurWidth":8,"blurHeight":3},"alt":"Banner quảng cáo dòng sản phẩm RIMO PREMIUM","className":"banner_bannerImage__k72hN","width":1920,"height":600,"priority":true}]}],["$","div",null,{"className":"introduce_introduceContainer__wkfAG padding-common","children":[["$","$L4",null,{"breadcrumb":"Giới thiệu","redirect":"/gioi-thieu","title":"CÔNG TY TNHH THƯƠNG MẠI XNK NỘI THẤT Ô TÔ QUANG MINH","blackColor":true}],["$","$L5",null,{}],["$","div",null,{"className":"introduce_container___Ehjc","children":[["$","h1",null,{"className":"introduce_title__IPnBs","id":"gioi-thieu","children":"CÔNG TY TNHH TM XNK NỘI THẤT Ô TÔ QUANG MINH"}],["$","p",null,{"className":"introduce_paragraph__Hj0wI","children":"Công ty TNHH Thương Mại Xuất nhập khẩu Nội thất ô tô Quang Minh chuyên cung cấp các sản phẩm phụ kiện, phim cách nhiệt chính hãng và uy tín trên toàn quốc. Không chỉ đem tới một sản phẩm tốt, một giải pháp thông minh mà chúng tôi còn luôn không ngừng đổi mới, sáng tạo để phù hợp với nhu cầu sử dụng tốt nhất của khách hàng tại Việt Nam."}],["$","h2",null,{"className":"introduce_heading__xlGUx","id":"tam-nhin","children":"Tầm nhìn"}],["$","p",null,{"className":"introduce_paragraph__Hj0wI","children":"Không ngừng thay đổi và lớn mạnh, Quang Minh định hướng chinh phục các mục tiêu phát triển to lớn, trở thành đơn vị uy tín hàng đầu châu Á về cung cấp các sản phẩm công nghệ nâng tầm nội thất cho ô tô."}],["$","p",null,{"className":"introduce_paragraph__Hj0wI","children":"Chúng tôi luôn chú trọng đầu tư vào các cơ sở trang thiết bị hiện đại, chuẩn quốc tế cùng đào tạo nguồn nhân lực chuyên môn cao, cung cấp các dịch vụ bền vững, nâng tầm những trải nghiệm giá trị nhất dành cho khách hàng."}],["$","h2",null,{"className":"introduce_heading__xlGUx","id":"su-menh","children":"Sứ mệnh"}],["$","p",null,{"className":"introduce_paragraph__Hj0wI","children":"Mang trong mình sứ mệnh vì khách hàng mà phụng sự, Quang Minh cam kết mang lại những giải pháp tốt nhất cho không gian nội thất ô tô của bạn."}],["$","p",null,{"className":"introduce_paragraph__Hj0wI","children":"Với các sản phẩm phim cách nhiệt chất lượng cao, chính hãng, giá thành đảm bảo niêm yết cùng sự chuyên nghiệp trong dịch vụ, chúng tôi tin rằng mọi khách hàng khi đến với Quang Minh đều sẽ nhận được sự hài lòng tuyệt đối."}],["$","h2",null,{"className":"introduce_heading__xlGUx","id":"gia-tri-cot-loi","children":"Giá trị cốt lõi RIMO"}],["$","p",null,{"className":"introduce_paragraph__Hj0wI","children":[["$","strong",null,{"children":"I – Integrity:"}]," Chính trực, minh bạch trong cách làm việc và nguồn gốc sản phẩm."]}],["$","p",null,{"className":"introduce_paragraph__Hj0wI","children":[["$","strong",null,{"children":"N – Navigation:"}]," Tiên phong công nghệ phún xạ 12 lớp kim loại trong phim cách nhiệt."]}],["$","p",null,{"className":"introduce_paragraph__Hj0wI","children":[["$","strong",null,{"children":"M – Morally:"}]," Làm việc bằng cái tâm, đặt đạo đức nghề nghiệp lên hàng đầu."]}],["$","p",null,{"className":"introduce_paragraph__Hj0wI","children":[["$","strong",null,{"children":"A – Acknowledge:"}]," Am hiểu sản phẩm, thấu hiểu khách hàng để đưa ra giải pháp phù hợp."]}],["$","p",null,{"className":"introduce_paragraph__Hj0wI","children":[["$","strong",null,{"children":"X:"}]," Tượng trưng cho cơ chế phản xạ nhiệt – giá trị cốt lõi của Rimo."]}],["$","h2",null,{"className":"introduce_heading__xlGUx","id":"su-khac-biet","children":"Sự khác biệt của phim cách nhiệt Rimo"}],["$","ul",null,{"className":"introduce_list__RiPQm","children":[["$","li",null,{"children":"Cản nhiệt tốt hơn 10–18°C so với các dòng phim hấp thụ nhiệt"}],["$","li",null,{"children":"Độ xuyên sáng cao, đảm bảo tầm nhìn khi lái xe"}],["$","li",null,{"children":"Độ bền lên đến 30 năm"}],["$","li",null,{"children":"Ngăn 99% tia UV và bức xạ hồng ngoại"}],["$","li",null,{"children":"Giữ mát xe, giảm tải cho hệ thống điều hòa"}],["$","li",null,{"children":"Bảo vệ kính, hạn chế nứt vỡ do nhiệt"}],["$","li",null,{"children":"Nhập khẩu chính hãng, kiểm định và bảo hành đầy đủ"}]]}],["$","h2",null,{"className":"introduce_heading__xlGUx","id":"doi-tac","children":"Đối tác của Rimo"}],["$","table",null,{"className":"introduce_tableMedia__fHc8y","children":["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","$L3",null,{"src":{"src":"/_next/static/media/VTV.af9be0e2.png","height":50,"width":126,"blurDataURL":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAADCAYAAACuyE5IAAAAbklEQVR4nGO8La/27B874zquW79VL8cLGntZSQir/v++mmWC+4v/HP+CQQrs/7MyHOC+8/tK/CTlx3tY2GR1F9p8+f2X0YLxJ6MT4x05VYa/HEzrJG59XM0/39Ra/e8bZZaUyGV/jb4GMf5iDAQAXDMqxFaAC8cAAAAASUVORK5CYII=","blurWidth":8,"blurHeight":3},"alt":"VTV","width":100,"height":100}]}],["$","td",null,{"children":["$","$L3",null,{"src":{"src":"/_next/static/media/HTV.30b573f8.png","height":40,"width":139,"blurDataURL":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAACCAYAAABllJ3tAAAATUlEQVR4nAFCAL3/AfTRzBv88PTI+uj